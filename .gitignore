.Rproj.user/
*.log
outputs/staging/

# Author scripts also write Stata logs / temp files into data/0_log and the
# timestamped run folders under data/5_graphs, data/6_tables.
data/0_log/*.log
data/5_graphs/*__*/
data/6_tables/*__*/

# data/4_results is regenerable author staging (metafile writes <ts>__<nrun>/,
# connectors alias to full_current_193 / full_current_no_lbd). Claimed sinks:
# outputs/compute_mvpf_*/compiled_results_*.dta. init_study_paths.do restores
# aliases from those outputs when missing. Do not commit run history or aliases.
data/4_results/**
!data/4_results/.gitkeep

# macros.do's per-user externality cache (author naming: files_v<username>) - a
# regenerable intermediate cache read by every downstream policy do-file, not a
# declared replication.yml output. Regenerated by the `macros` step.
data/1_assumptions/user_specific_assumptions/files_v*/

# Local bake/debug scratch at study root (not part of the DAG / study contract)
_*.R
_*.py
_*.txt
outputs/macros/_probe/

# Regenerable per-policy draw caches from full MVPF runs (not Display sinks)
data/2b_causal_estimates_draws/**
!data/2b_causal_estimates_draws/.gitkeep
data/3_bootstrap_draws/**
!data/3_bootstrap_draws/.gitkeep

# Author Stata graph export also writes .wmf; Display uses .png
data/5_graphs/figures_main/*.wmf
data/6_tables/tables_main/*
